# ==========================================
# 1. AI, LLM, & Agent Specific Exclusions
# ==========================================
# Local vector databases & storage blocks
.chroma/
.lance/
faiss_index/
qdrant_storage/
duckdb/

# Agentic frameworks state & local caching (e.g., CrewAI, AutoGen, Mem0)
.agent_cache/
.crewai/
.autogen/
.abstra/
.mem0/

# Large Language Model weights, fine-tuning checkpoints, and datasets
models/
weights/
checkpoints/
*.bin
*.pt
*.pth
*.gguf
*.safetensors
*.onnx

# Data engineering / local training data
data/raw/
data/processed/
*.csv
*.jsonl
*.parquet

# Evaluation & Observability logs (e.g., LangSmith, Phoenix, Arize caches)
.phoenix/
.langsmith/
logs/
*.log

# ==========================================
# 2. Environment Variables & Secret Hardening
# ==========================================
# CRITICAL: Prevent leaking OpenAI, Anthropic, or HuggingFace API keys
.env
.env.*
env.file
*.pem
*.key
secrets.toml

# ==========================================
# 3. AI IDEs & Coding Assistant Tooling
# ==========================================
# Exclude individual context/rules files if you don't want to share them with the team
.cursorrules
.cursorignore
.aiignore
.uignore

# ==========================================
# 4. Standard Python Hygiene
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
venv/
ENV/
env/
.envrc

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDEs and OS junk
.idea/
.vscode/
.DS_Store
Thumbs.db
